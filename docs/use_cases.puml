@startuml Use Cases Overview
' Source: docs/requirements.md (revised 2026-09-17 for the .elicit export workflow)
left to right direction

actor "Survey Author" as author
actor "System Administrator" as admin
actor "Identity Provider\n(Keycloak/OIDC)" as idp
actor "Admin App\n(Apply Survey Definition)" as adminapp

rectangle "Elicit Author" {

    ' Access (FR-032, FR-033)
    usecase "UC-001\nAuthenticate via OIDC" as UC001
    usecase "UC-002\nRestrict Authoring Access" as UC002

    ' Survey Definition Lifecycle (FR-001..FR-009)
    usecase "UC-003\nCreate Survey" as UC003
    usecase "UC-004\nEdit Survey Metadata" as UC004
    usecase "UC-005\nImport Survey Definition" as UC005
    usecase "UC-006\nBrowse Survey Structure" as UC006
    usecase "UC-007\nValidate Survey Definition" as UC007
    usecase "UC-008\nExport Survey Definition" as UC008
    usecase "UC-009\nRemove Structural Element" as UC009
    usecase "UC-010\nRestore Removed Element" as UC010

    ' Question Authoring (FR-010..FR-014)
    ' Token authoring (FR-012) and its preview (FR-013) are specified as part of UC-011 rather
    ' than as use cases of their own; they carried no specification of their own as UC-012/UC-013.
    usecase "UC-011\nAuthor Question" as UC011
    usecase "UC-014\nManage Select Groups and Items" as UC014

    ' Section & Step Organization (FR-015..FR-018)
    usecase "UC-015\nOrganize Sections into Steps" as UC015
    usecase "UC-016\nReorder Steps, Sections, and Questions" as UC016
    usecase "UC-017\nConfigure Repeating Elements" as UC017
    usecase "UC-018\nRename Step or Section" as UC018

    ' Logic & Relationships (FR-019..FR-022, FR-041, FR-064)
    usecase "UC-019\nCreate Conditional Relationship" as UC019
    usecase "UC-020\nVisualize Relationship Graph" as UC020
    usecase "UC-033\nValidate Rule Direction" as UC033

    ' Ontology & Metadata (FR-023..FR-026)
    usecase "UC-021\nAssign Ontology Tag to Question" as UC021
    usecase "UC-022\nReassign Ontology Tag" as UC022
    usecase "UC-023\nManage Ontology and Dimension Entries" as UC023
    usecase "UC-024\nPreview Dimensional Impact" as UC024

    ' Requirements Collection & First-Draft Generation (FR-027..FR-029)
    usecase "UC-025\nAuthor the Requirements-Collection Meta-Survey" as UC025
    usecase "UC-026\nGenerate First-Draft Structure from Meta-Survey Answers" as UC026
    usecase "UC-027\nRefine Generated Structure" as UC027

    ' Preview (FR-030)
    usecase "UC-028\nPreview Survey as Respondent" as UC028

    ' Guidance (FR-034, FR-047, FR-048)
    usecase "UC-029\nExplain the Survey Model" as UC029
    usecase "UC-039\nConsult the Author's Manual" as UC039
    usecase "UC-042\nDraft a Definition Outside Author" as UC042

    ' Branding (FR-037)
    usecase "UC-030\nBrand the Authoring Interface" as UC030

    ' System setup and diagnostics (FR-042..FR-046)
    usecase "UC-034\nView System Overview" as UC034
    usecase "UC-035\nDiagnose Database" as UC035
    usecase "UC-036\nDiagnose Branding" as UC036
    usecase "UC-037\nCheck Connections" as UC037
    usecase "UC-038\nView OIDC Diagnostics" as UC038

    ' Localization (FR-049..FR-055)
    usecase "UC-040\nAuthor Surveys in My Language" as UC040
    usecase "UC-041\nManage Languages" as UC041

    ' Content Translation (FR-056..FR-060)
    usecase "UC-043\nTranslate Survey Content" as UC043
    usecase "UC-044\nManage Content Languages" as UC044
    usecase "UC-045\nRequest a Content Translation" as UC045
    usecase "UC-046\nImport Content Translations" as UC046
}

' Access
author --> UC001
admin --> UC001
idp --> UC001
admin --> UC002

' Survey Definition Lifecycle
author --> UC003
author --> UC004
author --> UC005
author --> UC006
author --> UC007
author --> UC008
author --> UC009
author --> UC010
UC008 --> adminapp : .elicit file

' Question Authoring
author --> UC011
author --> UC014

' Section & Step Organization
author --> UC015
author --> UC016
author --> UC017
author --> UC018

' Logic & Relationships
author --> UC019
author --> UC020
author --> UC033

' Ontology & Metadata
author --> UC021
author --> UC022
author --> UC023
author --> UC024

' Requirements Collection & First-Draft Generation
author --> UC025
author --> UC026
author --> UC027

' Preview
author --> UC028

' Guidance
author --> UC029
author --> UC039
author --> UC042

' Branding
admin --> UC030

' System setup and diagnostics
admin --> UC034
admin --> UC035
admin --> UC036
admin --> UC037
admin --> UC038
UC034 ..> UC035 : <<directs to>>
UC034 ..> UC036 : <<directs to>>
UC034 ..> UC037 : <<directs to>>
UC036 ..> UC030 : <<reports>>

' Localization
author --> UC040
admin --> UC040
author --> UC041

' Content translation
author --> UC043
author --> UC044
author --> UC045
author --> UC046

' Relationships worth calling out explicitly
UC008 ..> UC007 : <<include>>
UC009 ..> UC007 : <<extend>>
UC025 ..> UC003 : <<include>>
UC026 ..> UC003 : <<include>>
UC027 ..> UC011 : <<extend>>
UC018 ..> UC007 : <<extend>> retroactive warning
UC015 ..> UC016 : <<include>> placing renumbers
UC011 ..> UC015 : <<extend>> question into section
UC016 ..> UC007 : <<extend>> initial display key
UC019 ..> UC020 : <<extend>> drag to connect
UC019 ..> UC033 : <<include>> refuse backward target
UC016 ..> UC033 : <<extend>> backward rules shown red
UC033 ..> UC007 : <<extend>> backward rule is an error
UC022 ..> UC007 : <<extend>> retroactive warning
UC039 ..> UC029 : <<extend>> printable form of the guide
UC041 ..> UC040 : <<extend>> adds a language to the selector
UC042 ..> UC029 : <<extend>> the same model, written for an AI agent
UC042 ..> UC005 : <<include>> the draft is opened by importing it
UC045 ..> UC043 : <<extend>> the bulk path out of the grid
UC046 ..> UC043 : <<extend>> the bulk path back in
UC044 ..> UC043 : <<include>> a language must be declared to be translated
UC043 ..> UC008 : <<extend>> translations travel in the definition file
UC043 ..> UC007 : <<extend>> stale and missing counts are export warnings
UC009 ..> UC043 : <<extend>> retiring an element retires its translations

' Not yet specified: UC-017 (FR-017), UC-025 (FR-027), UC-026 (FR-028), UC-027 (FR-029) and
' UC-028 (FR-030) are declared here as planned scope. Their requirements are Open and they have no
' file under docs/use_cases/ yet; every other use case on this diagram has one.
note as N_planned
  UC-017, UC-025, UC-026, UC-027 and UC-028
  are planned scope: requirements Open, no
  use case specification written yet.
end note

@enduml
