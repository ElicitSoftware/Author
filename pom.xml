<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.elicitsoftware</groupId>
    <artifactId>author</artifactId>
    <version>3.0.0-rc.2</version>
    <packaging>quarkus</packaging>

    <licenses>
        <license>
            <name>PolyForm Noncommercial License 1.0.0</name>
            <url>https://polyformproject.org/licenses/noncommercial/1.0.0</url>
        </license>
    </licenses>
    <organization>
        <name>Elicit Software LLC</name>
        <url>https://elicit.software</url>
    </organization>

    <properties>
        <compiler-plugin.version>3.15.0</compiler-plugin.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.version>3.40.1.2</quarkus.platform.version>
        <skipITs>true</skipITs>
        <surefire-plugin.version>3.5.6</surefire-plugin.version>
        <vaadin.version>25.3.5</vaadin.version>
        <javadoc-plugin.version>3.12.0</javadoc-plugin.version>
        <site-plugin.version>3.21.0</site-plugin.version>
        <timestamp>${maven.build.timestamp}</timestamp>
        <maven.build.timestamp.format>yyyy-MM-dd HH:mm:ss z</maven.build.timestamp.format>
        <!-- license-maven-plugin properties -->
        <license.thirdPartyFilename>Notice.txt</license.thirdPartyFilename>
        <license.includeTransitiveDependencies>false</license.includeTransitiveDependencies>
        <license.excludedScopes>test,provided</license.excludedScopes>
        <!--
            vaadin-dev is a dev-mode tool and is not distributed, so the notice must not list it.
            The vaadin-dev-tools profile adds the dependency whenever quarkus.profile is unset and
            add-third-party runs in the default lifecycle, so without this a plain `mvn test`
            regenerates Notice.txt naming a jar that never ships, while the image build (which sets
            quarkus.profile=docker) regenerates it without. Excluded outright so the file is the
            same either way.

            The plugin does not match this pattern on its own: it wraps it as
            `[^:]+:[^:]*(PATTERN)[^:]*` and matches that against groupId:artifactId, so a leading
            `^` can never match and `^vaadin-dev$` excluded nothing (Admin #124, here #93). The
            lookbehind anchors the artifactId's start at the colon instead, keeping the match exact
            (not vaadin-dev-server or any other artifactId that merely contains vaadin-dev).
        -->
        <license.excludedArtifacts>(?&lt;=:)vaadin-dev$</license.excludedArtifacts>
        <license.outputDirectory>${project.basedir}</license.outputDirectory>
        <!--
            add-third-party registers its output directory as a project resource with **/*.txt
            whenever it runs. With the root as that directory every .txt in the tree was packaged:
            the license-header templates under src/license and the i18n test allowlists (Elicit#70).
            Switched off here; the root resource declared under <build> packages Notice.txt alone.
        -->
        <license.addOutputDirectoryAsResourceDir>false</license.addOutputDirectoryAsResourceDir>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-bom</artifactId>
                <version>${vaadin.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <!-- UI -->
        <!-- UC-011 BR-004: sanitizes HTML question text before the preview renders it. The
             version is the one the Vaadin BOM manages, which Flow itself parses HTML with. -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-quarkus-extension</artifactId>
            <version>${vaadin.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>com.fasterxml.jackson.core</groupId>
                    <artifactId>jackson-annotations</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.fasterxml.jackson.core</groupId>
                    <artifactId>jackson-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.fasterxml.jackson.core</groupId>
                    <artifactId>jackson-databind</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Container Images -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-container-image-docker</artifactId>
        </dependency>
        <!-- Observability Stack -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-logging-json</artifactId>
        </dependency>
        <!-- Database — Author has no Flyway migrations of its own. It maps Hibernate/Panache
             entities onto the tables Survey's db/migration already owns (schema generation
             disabled; see application.properties). -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm-panache</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-validator</artifactId>
        </dependency>
        <!-- OIDC -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-oidc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-keycloak-authorization</artifactId>
        </dependency>
        <!-- Testing -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Annotation-based security mocking for @QuarkusTest: @TestSecurity + @OidcSecurity -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-test-security</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-test-security-oidc</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- PostgreSQL container for @QuarkusTest. Version is managed by the Quarkus BOM. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Vaadin browserless UI testing (Quarkus base class QuarkusBrowserlessTest) -->
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>browserless-test-quarkus</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Intentionally NOT scoped to test: this extension needs to be present on the
             main build path for @QuarkusTest coverage collection during `mvn test` (it
             instruments the application at build/augmentation time, not just at test time). -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jacoco</artifactId>
        </dependency>
        <!-- Test-only: replays a verbatim mirror of Survey's db/migration into the Testcontainers
             Postgres (src/test/resources/db/schema-mirror, refreshed by scripts/sync-survey-schema.sh).
             Author owns no production migrations (C-005); nothing Flyway-related ships in the image. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-flyway</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-flyway-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>
        <repository>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
            <id>Vaadin Directory</id>
            <url>https://maven.vaadin.com/vaadin-addons</url>
        </repository>
    </repositories>
    <pluginRepositories>
        <pluginRepository>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </pluginRepository>
    </pluginRepositories>

    <build>
        <!-- Filter application.properties only, so @project.version@ and @timestamp@ reach the
             System overview (UC-034); every other resource is copied verbatim. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>application.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>application.properties</exclude>
                </excludes>
            </resource>
            <!--
              The AI authoring specification (UC-042). It is written and reviewed as a document
              under docs/, and packaged here so that Author can hand it to an author who has no
              checkout of this repository: the whole point of the path is that the specification
              travels to an AI session, and an author cannot copy what they cannot reach.

              targetPath is ai/, deliberately not META-INF/resources, which Quarkus would serve
              to anyone without a role check. It reaches the browser only through
              AuthoringSpecificationResource, which requires the authoring role, exactly as the
              manual does.

              filtering must stay false: the specification's worked example contains ${...}-like
              sequences and token syntax that a filtered copy would mangle.
            -->
            <resource>
                <directory>docs/ai</directory>
                <targetPath>ai</targetPath>
                <filtering>false</filtering>
                <includes>
                    <include>AUTHORING_FROM_AI.md</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <!-- The third-party notice, generated at the project root so the committed copy is
                 the reviewed one, ships in the jar (Elicit#70). It is copied by an execution, not
                 declared as a <resource>: dev mode's hot reload watches every resource directory
                 and ignores <includes>, so a resource rooted at ${project.basedir} copied the
                 whole tree, target/ included, into target/classes on every pass. -->
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-notice</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}</directory>
                                    <filtering>false</filtering>
                                    <includes>
                                        <include>Notice.txt</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <!-- <packaging>quarkus</packaging> plus extensions=true already binds generate-code,
                     generate-code-tests, build and native-image-agent through the plugin's lifecycle
                     mapping. Do not add an <executions> block: it binds them a second time, so every
                     augmentation and the container-image build run twice per `mvn package`. -->
                <extensions>true</extensions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler-plugin.version}</version>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <configuration>
                    <argLine>@{argLine}</argLine>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <argLine>@{argLine}</argLine>
                    <systemPropertyVariables>
                        <native.image.path>${project.build.directory}/${project.build.finalName}-runner</native.image.path>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${javadoc-plugin.version}</version>
                <configuration>
                    <outputDirectory>${project.build.directory}/javadoc</outputDirectory>
                    <failOnWarnings>false</failOnWarnings>
                    <quiet>true</quiet>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <phase>package</phase>
                    </execution>
                    <execution>
                        <id>aggregate</id>
                        <goals>
                            <goal>aggregate</goal>
                        </goals>
                        <phase>site</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-site-plugin</artifactId>
                <version>${site-plugin.version}</version>
                <configuration>
                    <locales>en</locales>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <executions>
                    <execution>
                        <!--
                            Instrument plain (non-@QuarkusTest) unit tests. The
                            quarkus-jacoco extension only covers @QuarkusTest runs,
                            so without this agent the JUnit unit tests execute
                            un-instrumented and produce no coverage data.
                        -->
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <destFile>${project.build.directory}/jacoco.exec</destFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco.exec</dataFile>
                            <outputDirectory>${project.reporting.outputDirectory}/jacoco</outputDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jacoco-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco.exec</dataFile>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                            <excludes>
                                <!-- Quarkus-generated proxies and subclasses -->
                                <exclude>**/*$$*</exclude>
                                <exclude>**/*_ClientProxy*</exclude>
                                <exclude>**/*_Subclass*</exclude>
                                <exclude>**/*_Bean*</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!--
                    Pitest mutation testing (https://pitest.org). Not bound to any phase: it is slow
                    and on demand only, run as `./mvnw test-compile pitest:mutationCoverage`, with the
                    report at target/pit-reports/index.html.

                    targetTests names the plain unit tests one by one, on purpose. A @QuarkusTest (or
                    QuarkusBrowserlessTest) loads the application through QuarkusClassLoader, which
                    reads the original bytes from target/classes and never sees Pitest's mutant, so
                    every mutant it covers would be reported as surviving; it would also boot the
                    application and a PostgreSQL container once per mutant. There is no glob that
                    separates the two kinds, so a new plain unit test is added here by hand; leaving
                    one out only lowers the score, where wrongly including a booted test would
                    falsify it.
                -->
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>1.30.1</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>1.2.3</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <targetClasses>
                        <param>com.elicitsoftware.*</param>
                    </targetClasses>
                    <targetTests>
                        <param>com.elicitsoftware.SchemaMirrorFreshnessTest</param>
                        <param>com.elicitsoftware.author.ConstraintViolationTranslatorTest</param>
                        <param>com.elicitsoftware.author.definition.DefinitionValueTypesTest</param>
                        <param>com.elicitsoftware.author.definition.ElicitFormatTest</param>
                        <param>com.elicitsoftware.author.diagnostics.CheckResultTest</param>
                        <param>com.elicitsoftware.author.flow.AppConfigTest</param>
                        <param>com.elicitsoftware.author.flow.BrandResourceHandlerTest</param>
                        <param>com.elicitsoftware.author.flow.designer.PaletteItemTest</param>
                        <param>com.elicitsoftware.author.flow.designer.PreviewFieldsTest</param>
                        <param>com.elicitsoftware.author.flow.designer.QuestionDialogBoundsTest</param>
                        <param>com.elicitsoftware.author.flow.designer.RelationshipDialogPathTest</param>
                        <param>com.elicitsoftware.author.i18n.DisplayedStringsCoverageTest</param>
                        <param>com.elicitsoftware.author.i18n.ElicitI18NProviderTest</param>
                        <param>com.elicitsoftware.author.i18n.LocaleConfigTest</param>
                        <param>com.elicitsoftware.author.i18n.TokenSyntaxInBundlesTest</param>
                        <param>com.elicitsoftware.author.i18n.TranslationBundleConsistencyTest</param>
                        <param>com.elicitsoftware.author.i18n.TranslationRequestGeneratorTest</param>
                        <param>com.elicitsoftware.author.survey.ContentHashTest</param>
                        <param>com.elicitsoftware.author.survey.ContentLanguagesTest</param>
                        <param>com.elicitsoftware.author.survey.DesignerAddressTest</param>
                        <param>com.elicitsoftware.author.survey.LanguageTagsTest</param>
                        <param>com.elicitsoftware.author.survey.RepeatSourceTest</param>
                        <param>com.elicitsoftware.author.survey.ReportingNamesTest</param>
                        <param>com.elicitsoftware.author.survey.RuleOrderingTest</param>
                        <param>com.elicitsoftware.author.survey.RulePathTest</param>
                        <param>com.elicitsoftware.author.survey.StructureNodeTest</param>
                        <param>com.elicitsoftware.author.survey.TokenSamplesTest</param>
                        <param>com.elicitsoftware.author.survey.TokensTest</param>
                        <param>com.elicitsoftware.author.survey.TranslatableFieldsTest</param>
                        <param>com.elicitsoftware.author.survey.TranslationBudgetTest</param>
                        <param>com.elicitsoftware.author.util.BrandUtilTest</param>
                    </targetTests>
                    <jvmArgs>
                        <jvmArg>-Djava.util.logging.manager=org.jboss.logmanager.LogManager</jvmArg>
                    </jvmArgs>
                    <outputFormats>
                        <format>HTML</format>
                        <format>XML</format>
                    </outputFormats>
                    <timestampedReports>false</timestampedReports>
                    <threads>4</threads>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>2.7.1</version>
                <configuration>
                    <inceptionYear>2025</inceptionYear>
                    <licenseName>polyform</licenseName>
                    <organizationName>Elicit Software LLC</organizationName>
                    <projectName>Elicit Author</projectName>
                    <emptyLineAfterHeader>true</emptyLineAfterHeader>
                    <excludes>
                        <exclude>**/*.properties</exclude>
                        <!-- JSON has no comment syntax: a header makes the file unparseable.
                             This covers brand-config.json, brand-info.json, typography.json,
                             i18n-config.json and anything added later. -->
                        <exclude>**/*.json</exclude>
                    </excludes>
                    <licenseResolver>${project.baseUri}src/license</licenseResolver>
                    <processStartTag>***LICENSE_START***</processStartTag>
                    <processEndTag>***LICENSE_END***</processEndTag>
                    <connectTimeout>3000</connectTimeout>
                    <socketTimeout>3000</socketTimeout>
                    <errorRemedy>ignore</errorRemedy>
                </configuration>
                <executions>
                    <execution>
                        <id>first</id>
                        <goals>
                            <goal>update-file-header</goal>
                        </goals>
                        <phase>process-sources</phase>
                    </execution>
                    <execution>
                        <id>add-third-party-licenses</id>
                        <goals>
                            <goal>add-third-party</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>aggregate-download-licenses</id>
                        <goals>
                            <goal>aggregate-download-licenses</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <reporting>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${javadoc-plugin.version}</version>
                <reportSets>
                    <reportSet>
                        <reports>
                            <report>javadoc</report>
                            <report>aggregate</report>
                        </reports>
                    </reportSet>
                </reportSets>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-project-info-reports-plugin</artifactId>
                <version>3.9.0</version>
                <reportSets>
                    <reportSet>
                        <reports>
                            <report>index</report>
                            <report>summary</report>
                            <report>dependency-info</report>
                            <report>modules</report>
                            <report>team</report>
                            <report>scm</report>
                            <report>issue-management</report>
                            <report>mailing-lists</report>
                            <report>dependency-management</report>
                            <report>dependencies</report>
                            <report>dependency-convergence</report>
                            <report>ci-management</report>
                            <report>plugin-management</report>
                            <report>plugins</report>
                            <report>distribution-management</report>
                        </reports>
                    </reportSet>
                </reportSets>
            </plugin>
        </plugins>
    </reporting>

    <profiles>
        <profile>
            <!-- Vaadin dev tools (dev server, Copilot, dev bundle) for dev mode and tests.
                 Active only when no -Dquarkus.profile is passed on the Maven command line, so
                 the image build (-Dquarkus.profile=docker) keeps them off the build classpath.
                 Quarkus packages optional dependencies, and filtering them only at packaging
                 time breaks startup because augmentation has already generated a bean for
                 vaadin-dev's DevModeStartupListener. -->
            <id>vaadin-dev-tools</id>
            <activation>
                <property>
                    <name>!quarkus.profile</name>
                </property>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>com.vaadin</groupId>
                    <artifactId>vaadin-dev</artifactId>
                    <optional>true</optional>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <quarkus.package.jar.enabled>false</quarkus.package.jar.enabled>
                <skipITs>false</skipITs>
                <quarkus.native.enabled>true</quarkus.native.enabled>
            </properties>
        </profile>
        <profile>
            <id>production</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.vaadin</groupId>
                        <artifactId>vaadin-maven-plugin</artifactId>
                        <version>${vaadin.version}</version>
                        <configuration>
                            <frontendHotdeploy>true</frontendHotdeploy>
                        </configuration>
                        <executions>
                            <execution>
